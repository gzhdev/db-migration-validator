{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Table Mapping Configuration",
  "description": "数据库迁移字段映射配置规范",
  "type": "object",
  "required": ["version", "source_db", "target_db", "tables"],
  "properties": {
    "version": {
      "type": "string",
      "description": "配置文件版本",
      "pattern": "^\\d+\\.\\d+$"
    },
    "source_db": {
      "type": "object",
      "description": "源数据库连接配置",
      "required": ["type", "host"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["mysql", "postgresql", "oracle", "sqlserver", "sqlite"],
          "description": "数据库类型"
        },
        "host": { "type": "string", "description": "数据库主机" },
        "port": { "type": "integer", "description": "数据库端口" },
        "database": { "type": "string", "description": "数据库名称 / Oracle service_name" },
        "user": { "type": "string", "description": "用户名" },
        "password": { "type": "string", "description": "密码（建议使用环境变量）" },
        "password_env": { "type": "string", "description": "密码环境变量名" },
        "service_name": { "type": "string", "description": "Oracle service_name（优先于 database）" },
        "sid": { "type": "string", "description": "Oracle SID（与 service_name 二选一）" },
        "thick_mode": { "type": "boolean", "default": false, "description": "Oracle 是否使用 Thick 模式（需要 Oracle Client）" },
        "oracle_client": { "type": "string", "description": "Oracle Client 库路径（thick_mode=true 时使用）" }
      }
    },
    "target_db": {
      "$ref": "#/properties/source_db",
      "description": "目标数据库连接配置"
    },
    "tables": {
      "type": "array",
      "description": "表映射配置列表",
      "items": {
        "type": "object",
        "required": ["target_table", "field_mappings"],
        "oneOf": [
          { "required": ["source_table"] },
          { "required": ["source_tables"] }
        ],
        "properties": {
          "source_table": {
            "type": "string",
            "description": "源表名（单表模式）"
          },
          "source_tables": {
            "type": "array",
            "description": "多表 JOIN 源表配置（多表模式）",
            "items": {
              "type": "object",
              "required": ["table_name", "alias"],
              "properties": {
                "table_name": {
                  "type": "string",
                  "description": "源表名"
                },
                "alias": {
                  "type": "string",
                  "description": "表别名（在字段映射中引用）"
                },
                "schema": {
                  "type": "string",
                  "description": "源表 schema"
                },
                "join_type": {
                  "type": "string",
                  "enum": ["primary", "inner", "left", "right", "full", "cross"],
                  "default": "inner",
                  "description": "JOIN 类型，第一个表使用 'primary'"
                },
                "join_condition": {
                  "type": "string",
                  "description": "JOIN 条件（第一个表除外，必需）"
                }
              }
            }
          },
          "target_table": {
            "type": "string",
            "description": "目标表名"
          },
          "source_schema": {
            "type": "string",
            "description": "源表 schema（如 PostgreSQL 的 schema，单表模式）"
          },
          "target_schema": {
            "type": "string",
            "description": "目标表 schema"
          },
          "description": {
            "type": "string",
            "description": "映射说明"
          },
          "table_filters": {
            "type": "object",
            "description": "多表模式下各表的过滤条件（key 为表别名）",
            "additionalProperties": {
              "type": "string",
              "description": "SQL WHERE 子句"
            }
          },
          "field_mappings": {
            "type": "array",
            "description": "字段映射配置",
            "items": {
              "type": "object",
              "required": ["target_field"],
              "oneOf": [
                { "required": ["source_field"] },
                { "required": ["transform"] }
              ],
              "properties": {
                "target_field": {
                  "type": "string",
                  "description": "目标表字段名"
                },
                "source_field": {
                  "type": "string",
                  "description": "源表字段名（直接映射时使用，多表模式支持 alias.field 格式）"
                },
                "transform": {
                  "type": "object",
                  "description": "字段转换配置",
                  "required": ["type"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "concat", "split", "substring", "replace",
                        "upper", "lower", "trim", "math",
                        "date_format", "date_add", "coalesce",
                        "case", "custom", "constant", "json_extract",
                        "cast", "null_if", "greatest", "least"
                      ],
                      "description": "转换类型"
                    },
                    "fields": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "参与转换的源字段列表（多表模式支持 alias.field 格式）"
                    },
                    "separator": {
                      "type": "string",
                      "description": "concat/split 时的分隔符"
                    },
                    "start": {
                      "type": "integer",
                      "description": "substring 起始位置（从1开始）"
                    },
                    "length": {
                      "type": "integer",
                      "description": "substring 长度"
                    },
                    "pattern": {
                      "type": "string",
                      "description": "replace/regex 的模式"
                    },
                    "replacement": {
                      "type": "string",
                      "description": "replace 的替换值"
                    },
                    "format": {
                      "type": "string",
                      "description": "date_format 的格式字符串"
                    },
                    "interval": {
                      "type": "string",
                      "description": "date_add 的时间间隔，如 '1 day', '-7 days'"
                    },
                    "value": {
                      "description": "constant 或 null_if 的值"
                    },
                    "default": {
                      "description": "coalesce 的默认值"
                    },
                    "cases": {
                      "type": "array",
                      "description": "case 转换的条件分支",
                      "items": {
                        "type": "object",
                        "properties": {
                          "when": { "type": "string" },
                          "then": { "type": "string" }
                        }
                      }
                    },
                    "else": {
                      "description": "case 的默认值"
                    },
                    "expression": {
                      "type": "string",
                      "description": "math/custom 转换的表达式（多表模式支持 alias.field 格式）"
                    },
                    "cast_type": {
                      "type": "string",
                      "enum": ["string", "int", "float", "bool", "date", "datetime"],
                      "description": "cast 的目标类型"
                    },
                    "args": {
                      "type": "object",
                      "description": "自定义参数"
                    }
                  }
                },
                "is_primary_key": {
                  "type": "boolean",
                  "default": false,
                  "description": "是否为主键字段"
                },
                "nullable": {
                  "type": "boolean",
                  "default": true,
                  "description": "是否允许为空（用于取值范围校验）"
                },
                "compare_rule": {
                  "type": "string",
                  "enum": ["exact", "ignore_case", "ignore_whitespace", "numeric_tolerance", "skip"],
                  "default": "exact",
                  "description": "比较规则：精确比较、忽略大小写、忽略空白、数值容差、跳过比较"
                },
                "tolerance": {
                  "type": "number",
                  "description": "数值比较时的容差范围（当 compare_rule=numeric_tolerance 时使用）"
                },
                "description": {
                  "type": "string",
                  "description": "字段映射说明"
                },
                "min_value": {
                  "type": "number",
                  "description": "取值范围校验：最小值"
                },
                "max_value": {
                  "type": "number",
                  "description": "取值范围校验：最大值"
                },
                "allowed_values": {
                  "type": "array",
                  "description": "取值范围校验：允许值列表",
                  "items": {}
                },
                "pattern": {
                  "type": "string",
                  "description": "取值范围校验：正则表达式"
                },
                "value_check_expr": {
                  "type": "string",
                  "description": "取值范围校验：自定义 Spark SQL 表达式"
                }
              }
            }
          },
          "filters": {
            "type": "object",
            "description": "数据过滤条件（单表模式）",
            "properties": {
              "source_filter": {
                "type": "string",
                "description": "源表过滤条件 SQL WHERE 子句"
              },
              "target_filter": {
                "type": "string",
                "description": "目标表过滤条件 SQL WHERE 子句"
              }
            }
          },
          "sample_size": {
            "type": "integer",
            "default": 0,
            "description": "抽样校验数量，0 表示全量校验"
          },
          "batch_size": {
            "type": "integer",
            "default": 1000,
            "description": "批量查询大小"
          }
        }
      }
    },
    "global_settings": {
      "type": "object",
      "description": "全局设置",
      "properties": {
        "parallel_workers": {
          "type": "integer",
          "default": 4,
          "description": "并行工作线程数"
        },
        "timeout_seconds": {
          "type": "integer",
          "default": 3600,
          "description": "超时时间（秒）"
        },
        "output_dir": {
          "type": "string",
          "default": "./reports",
          "description": "报告输出目录"
        },
        "report_format": {
          "type": "array",
          "items": { "type": "string", "enum": ["json", "csv", "html", "markdown"] },
          "default": ["json", "html"],
          "description": "报告输出格式"
        },
        "debug": {
          "type": "object",
          "description": "Debug 模式配置（Spark版）",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "是否启用 debug 模式"
            },
            "output_dir": {
              "type": "string",
              "default": "./debug",
              "description": "debug 输出目录"
            },
            "formats": {
              "type": "array",
              "items": { "type": "string", "enum": ["jsonl", "html"] },
              "default": ["jsonl", "html"],
              "description": "输出格式：jsonl（数据导出）、html（交互式报告）"
            },
            "max_records": {
              "type": "integer",
              "default": 10000,
              "minimum": 0,
              "description": "最多记录的比对条数，0 表示不限制"
            },
            "buffer_size": {
              "type": "integer",
              "default": 1000,
              "minimum": 100,
              "description": "JSONL 写入缓冲区大小"
            },
            "record_types": {
              "type": "object",
              "description": "记录类型过滤配置",
              "properties": {
                "matched": {
                  "type": "boolean",
                  "default": false,
                  "description": "是否记录完全匹配的记录"
                },
                "mismatched": {
                  "type": "boolean",
                  "default": true,
                  "description": "是否记录字段不匹配的记录"
                },
                "missing_in_source": {
                  "type": "boolean",
                  "default": true,
                  "description": "是否记录源表缺失的记录"
                },
                "missing_in_target": {
                  "type": "boolean",
                  "default": true,
                  "description": "是否记录目标表缺失的记录"
                },
                "value_check_failed": {
                  "type": "boolean",
                  "default": true,
                  "description": "是否记录取值范围校验失败的记录"
                }
              }
            },
            "data_content": {
              "type": "object",
              "description": "数据内容配置",
              "properties": {
                "include_raw_source": {
                  "type": "boolean",
                  "default": true,
                  "description": "是否包含原始源数据"
                },
                "include_expected": {
                  "type": "boolean",
                  "default": true,
                  "description": "是否包含转换后的期望值"
                },
                "include_target": {
                  "type": "boolean",
                  "default": true,
                  "description": "是否包含目标表实际值"
                }
              }
            }
          }
        }
      }
    }
  }
}